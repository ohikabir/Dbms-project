# Copy this file to ".env" and adjust. Never commit the real .env.

# --- Optional database access -------------------------------------------
# Leave DATABASE_URL empty to run in stateless mode: the POST endpoints
# (/api/forecast/demand, /api/forecast/reorder-plan) work fine without it.
# Set it to enable the GET /api/forecast/product/... endpoints.
#
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# Local development (matches backend/src/main/resources/application.properties):
DATABASE_URL=

# Uncomment to enable database-backed endpoints locally:
# DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/scm_db

# --- Behaviour ----------------------------------------------------------
# Sales-order status that counts as real demand. Must match the Spring
# backend's AnalyticsService.computeDemandStats(), which uses SHIPPED.
DEMAND_ORDER_STATUS=SHIPPED

DEFAULT_HORIZON_DAYS=30
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_LEAD_TIME_DAYS=7

# Comma-separated list of origins allowed to call this service from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

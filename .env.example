# Copy to ".env" for `docker compose up`. Never commit the real .env.
#
# These defaults match backend/src/main/resources/application.properties so a
# Compose run behaves like the existing local setup.

POSTGRES_DB=scm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# Must be reachable from the user's browser, not just from inside Compose.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Known tech debt, tracked in TODO.md --------------------------------
# The JWT signing secret is still HARDCODED in
# backend/src/main/java/com/example/scmbackend/security/JwtUtil.java.
# Before any real deployment it should be read from an environment variable
# and set here instead:
#
#   JWT_SECRET=<a long random string, at least 32 bytes>
#
# Until JwtUtil is changed to read it, setting this has no effect.

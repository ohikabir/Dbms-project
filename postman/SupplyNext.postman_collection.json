{
  "info": {
    "name": "SupplyNext API",
    "description": "Full API collection for SupplyNext \u2014 a multi-warehouse smart supply chain management system.\n\n## Getting started\n1. Select the **SupplyNext - Local** environment (top-right).\n2. Run **1. Auth > Register (ADMIN)** once.\n3. Run **1. Auth > Login** \u2014 the token is saved automatically and every other request picks it up.\n4. Work top to bottom: warehouses and categories first, then suppliers, products, inventory, and finally orders.\n\n## Notes\n- Every list endpoint is paginated (`?page=0&size=10`).\n- Analytics only counts **SHIPPED** sales orders as demand, so ship a few orders before expecting meaningful numbers.\n- Folder 12 targets the Python ML service on `{{mlUrl}}`, not the backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "mlUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Run **Login** first \u2014 its test script stores the JWT in the `token` environment variable, which every other request uses.",
      "item": [
        {
          "name": "Register (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user. Password is BCrypt-hashed; the response never includes it. Role defaults to STAFF when omitted.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Register (STAFF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "A STAFF user, useful for checking that role restrictions really bite.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff\",\n  \"password\": \"staff123\",\n  \"role\": \"STAFF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Returns {token, role} and saves the token automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the JWT into the environment so every other request in this",
                  "// collection authenticates automatically. Run this request first.",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.environment.set('token', body.token);",
                  "    pm.environment.set('role', body.role);",
                  "    console.log('Token saved. Role: ' + body.role);",
                  "}",
                  "",
                  "pm.test('login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('a token came back', function () {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

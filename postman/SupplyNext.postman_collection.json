    {
      "name": "11. Analytics (Phase B)",
      "description": "Smart analytics. EOQ and ABC need product cost fields; safety stock and reorder point need the supplier's leadTimeDays.",
      "item": [
        {
          "name": "EOQ (all products)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/eoq",
